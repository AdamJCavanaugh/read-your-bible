# =============================================================================
# FLUTTER/DART PROJECT .gitignore
# =============================================================================
# This file covers all standard Flutter/Dart project patterns including
# multi-platform support (Android, iOS, Web, Windows, macOS, Linux)
# =============================================================================

# -----------------------------------------------------------------------------
# Dart/Flutter/Pub
# -----------------------------------------------------------------------------
# Build outputs
build/
*.dart_tool/
.pub/
.pub-cache/
.packages
.packages.generated
.flutter-plugins
.flutter-plugins-dependencies

# Generated files
**/generated_plugin_registrant.dart
**/GeneratedPluginRegistrant.*

# Flutter tool caches
**/flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# -----------------------------------------------------------------------------
# IDE/Editor
# -----------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# Other editors
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS-specific
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# -----------------------------------------------------------------------------
# Android
# -----------------------------------------------------------------------------
.gradle/
local.properties
*.jks
*.keystore
key.properties
**/captures/
**/gradle-wrapper.jar
**/gradlew
**/gradlew.bat
**/.cxx/

# -----------------------------------------------------------------------------
# iOS / macOS
# -----------------------------------------------------------------------------
# Xcode
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
*sync/
.sconsign.dblite
.tags*
.vagrant/
DerivedData/
Icon?
Pods/
.symlinks/
profile
xcuserdata/
.generated/

# Flutter iOS specific
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
x64/
x86/
*.[Cc]ache
!*.[Cc]ache/

# -----------------------------------------------------------------------------
# Linux
# -----------------------------------------------------------------------------
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
# Build output
build/web/

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
# Database files (large binary assets) - add to .gitignore but track via Git LFS
# Uncomment the next line if you want to use Git LFS for database files
# *.db

# Metadata files
.metadata

# Coverage
coverage/

# Symbols
app.*.symbols

# Analysis/benchmark
analysis_benchmark.json

# -----------------------------------------------------------------------------
# Exceptions (files that SHOULD be tracked)
# -----------------------------------------------------------------------------
# Keep default Xcode configs
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# Keep CI configuration
!.github/

# Keep VS Code recommended settings
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json