# Git Attributes for read-your-bible
# See: https://git-scm.com/docs/gitattributes

# =============================================================================
# Git LFS - Large File Storage
# =============================================================================
# Bible database files are large binary files - track with Git LFS
*.db filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Text Files - Ensure consistent line endings
# =============================================================================
# Dart/Flutter files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Configuration files
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Code files
*.kt text eol=lf
*.swift text eol=lf
*.java text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# =============================================================================
# Binary Files - Don't diff or merge
# =============================================================================
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Compiled/built artifacts
*.so binary
*.dll binary
*.dylib binary
*.a binary
*.o binary
*.obj binary
*.class binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.ipa binary
*.app binary
*.framework binary
*.xcframework binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.rar binary

# =============================================================================
# Export/Ignore for git archive
# =============================================================================
# Don't include these in release archives
/.github export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/.idea export-ignore
/.vscode export-ignore
/.metadata export-ignore
/*.iml export-ignore
/tools export-ignore
/bibles export-ignore